VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN tt_um_template ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 130000 49000 ) ;
COMPONENTS 0 ;
END COMPONENTS
PINS 32 ;
    - CLK + NET CLK + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -150 -500 ) ( 150 500 )
        + PLACED ( 53500 500 ) S ;
    - RESET_N + NET RESET_N + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -150 -500 ) ( 150 500 )
        + PLACED ( 55200 500 ) S ;
    - SYNCED + NET SYNCED + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 3000 48800 ) N ;
    - SYNCING + NET SYNCING + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 5000 48800 ) N ;
    - DI0 + NET DI0 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 7000 48800 ) N ;
