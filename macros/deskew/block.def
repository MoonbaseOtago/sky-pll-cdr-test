        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 69000 48800 ) N ;
    - XMT_RD + NET XMT_RD + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 71000 48800 ) N ;
    - RESET_OUT_N + NET RESET_OUT_N + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 73000 48800 ) N ;
    - RESTART + NET RESTART + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 77000 48800 ) N ;


END PINS
SPECIALNETS 2 ;
    - VGND + USE GROUND ;
    - VPWR + USE POWER ;
END SPECIALNETS
NETS 32 ;
    - CLK ( PIN CLK ) + USE SIGNAL ;
    - RESET_OUT_N ( PIN RESET_OUT_N ) + USE SIGNAL ;
    - RESET_N ( PIN RESET_N ) + USE SIGNAL ;
    - RESTART ( PIN RESTART ) + USE SIGNAL ;
    - DIN ( PIN DIN ) + USE SIGNAL ;
    - REV ( PIN REV ) + USE SIGNAL ;
    - CLK10 ( PIN CLK10 ) + USE SIGNAL ;
    - DOUT ( PIN DOUT ) + USE SIGNAL ;
    - XMT_READY ( PIN XMT_READY ) + USE SIGNAL ;
    - XMT_RD ( PIN XMT_RD ) + USE SIGNAL ;
    - SYNCING ( PIN SYNCING ) + USE SIGNAL ;
    - SYNCED ( PIN SYNCED ) + USE SIGNAL ;
    - DO0 ( PIN DO0 ) + USE SIGNAL ;
    - DO1 ( PIN DO1 ) + USE SIGNAL ;
    - DO2 ( PIN DO2 ) + USE SIGNAL ;
    - DO3 ( PIN DO3 ) + USE SIGNAL ;
    - DO4 ( PIN DO4 ) + USE SIGNAL ;
    - DO5 ( PIN DO5 ) + USE SIGNAL ;
    - DO6 ( PIN DO6 ) + USE SIGNAL ;
    - DO7 ( PIN DO7 ) + USE SIGNAL ;
    - DO8 ( PIN DO8 ) + USE SIGNAL ;
    - DO9 ( PIN DO9 ) + USE SIGNAL ;
    - DI0 ( PIN DI0 ) + USE SIGNAL ;
    - DI1 ( PIN DI1 ) + USE SIGNAL ;
    - DI2 ( PIN DI2 ) + USE SIGNAL ;
    - DI3 ( PIN DI3 ) + USE SIGNAL ;
    - DI4 ( PIN DI4 ) + USE SIGNAL ;
    - DI5 ( PIN DI5 ) + USE SIGNAL ;
    - DI6 ( PIN DI6 ) + USE SIGNAL ;
    - DI7 ( PIN DI7 ) + USE SIGNAL ;
    - DI8 ( PIN DI8 ) + USE SIGNAL ;
    - DI9 ( PIN DI9 ) + USE SIGNAL ;
END NETS
END DESIGN
