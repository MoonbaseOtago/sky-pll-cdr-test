      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 17000 48800 ) N ;
    - DI6 + NET DO6 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 19000 48800 ) N ;
    - DI7 + NET DI7 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 21000 48800 ) N ;
    - DI8 + NET DI8 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 23000 48800 ) N ;
    - DI9 + NET DI9 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 25000 48800 ) N ;
    - DOUT + NET DOUT + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met1 ( -200 -100 ) ( 200 100 )
        + PLACED ( 129500 31800 ) E ;
    - CLK10 + NET CLK10 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 31000 48800 ) N ;
    - REV + NET REV + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met1 ( -200 -100 ) ( 200 100 )
        + PLACED ( 129500 40000 ) E ;
    - DIN + NET DIN + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met1 ( -200 -100 ) ( 200 100 )
        + PLACED ( 129500 42000 ) E ;
    - DO0 + NET DO0 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 49000 48800 ) N ;
    - DO1 + NET DO1 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
