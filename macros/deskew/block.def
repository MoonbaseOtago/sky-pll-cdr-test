    - DO2 + NET DO2 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 53000 48800 ) N ;
    - DO3 + NET DO3 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 55000 48800 ) N ;
    - DO4 + NET DO4 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
