    - DO5 + NET DO5 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 59000 48800 ) N ;
    - DO6 + NET DO6 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
        + PLACED ( 61000 48800 ) N ;
    - DO7 + NET DO7 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -100 -200 ) ( 100 200 )
